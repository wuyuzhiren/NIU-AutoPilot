<?xml version="1.0" encoding="utf-8"?>
<!-- v2.67 科幻HUD玻璃卡片：深色半透明 + 发光边框（v2.2 随主题切换） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外发光描边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="@color/vehicle_glass_stroke"/>
        </shape>
    </item>
    <!-- 玻璃面板 -->
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/vehicle_glass_bg"/>
            <corners android:radius="15dp"/>
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形快捷按钮背景（含按压状态） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/vehicle_button_bg_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/vehicle_button_stroke_active" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/vehicle_button_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/vehicle_button_stroke" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  HUD 科幻快捷按钮背景 — 圆形带科技边框
  按压时边框发光、背景变亮
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/vehicle_button_bg_pressed" />
            <stroke
                android:width="2dp"
                android:color="@color/vehicle_button_stroke_active" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/vehicle_button_bg" />
            <stroke
                android:width="1dp"
                android:color="#334155" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/vehicle_button_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/vehicle_button_stroke" />
        </shape>
    </item>
</selector>

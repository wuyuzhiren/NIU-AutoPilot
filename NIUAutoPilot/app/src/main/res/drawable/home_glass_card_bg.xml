<?xml version="1.0" encoding="utf-8"?>
<!--
  玻璃拟态信息卡背景（深色模式）
  实现方式：纯色 + alpha 模拟磨砂玻璃
  如需真模糊：接入 BlurView 库，用此 drawable 作 fallback overlay
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/vehicle_glass_bg" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/vehicle_glass_stroke" />
</shape>

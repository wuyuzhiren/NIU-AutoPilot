<?xml version="1.0" encoding="utf-8"?>
<!--
  主页背景 — 深空 HUD 径向渐变
  深色：中心微亮 #0F172A → 边缘深空 #0A0E17
  浅色：中心 #F8FAFC → 边缘 #F0F4F8
  由 values/colors.xml 中 vehicle_bg_deep_space 控制底色
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vehicle_bg_deep_space" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="100%p"
                android:centerX="0.5"
                android:centerY="0.35"
                android:startColor="@color/vehicle_stage_bg"
                android:endColor="@android:color/transparent"
                android:useLevel="false" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!--
  科幻网格背景 Drawable
  低端机可替换为纯色 @color/vehicle_bg_deep_space 以节省绘制开销
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vehicle_bg_deep_space" />
        </shape>
    </item>
    <!-- 注：精细网格线建议用 Canvas 在 OverlayView 中绘制，
         此处仅用渐变模拟空间感，避免过度绘制 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="120%p"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#0F172A"
                android:endColor="#0A0E17"
                android:useLevel="false" />
        </shape>
    </item>
</layer-list>

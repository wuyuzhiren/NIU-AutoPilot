<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 智能调参"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择日志来源（本地文件/GitHub/按时间段导出），AI 自动分析并推荐最优参数"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="16dp" />

        <!-- 日志来源选择 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择日志来源"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_pick_local"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选择本地日志"
                android:backgroundTint="#E8F5E9"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_pick_github"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="从GitHub加载"
                android:backgroundTint="#E3F2FD"
                android:textColor="#1976D2"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- 当前选中的日志 -->
        <TextView
            android:id="@+id/tv_selected_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未选择日志，将按下方时间段导出"
            android:textSize="12sp"
            android:textColor="#FF9800"
            android:background="#FFF8E1"
            android:padding="8dp"
            android:layout_marginBottom="12dp" />

        <!-- 时间段选择 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="或按时间段导出（未选择日志时使用）"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开始时间"
                    android:textSize="12sp"
                    android:textColor="#888888" />

                <Button
                    android:id="@+id/btn_start_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择时间"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="结束时间"
                    android:textSize="12sp"
                    android:textColor="#888888" />

                <Button
                    android:id="@+id/btn_end_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择时间"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#333333"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 快捷选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_quick_1h"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="近1小时"
                android:backgroundTint="#E3F2FD"
                android:textColor="#1976D2"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_quick_3h"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="近3小时"
                android:backgroundTint="#E3F2FD"
                android:textColor="#1976D2"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_quick_today"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="今天"
                android:backgroundTint="#E3F2FD"
                android:textColor="#1976D2"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- AI 配置状态 -->
        <TextView
            android:id="@+id/tv_ai_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="12dp" />

        <!-- 开始分析按钮 -->
        <Button
            android:id="@+id/btn_analyze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="AI 智能分析"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7C4DFF"
            android:layout_marginBottom="16dp" />

        <!-- 分析进度 -->
        <TextView
            android:id="@+id/tv_analyzing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#1976D2"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- 分析结果卡片 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI 分析结果"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_analysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="推荐参数"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginBottom="12dp">

                    <TextView android:text="靠近阈值" android:textSize="13sp" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>
                    <TextView android:id="@+id/tv_rec_near" android:textSize="13sp" android:textStyle="bold" android:textColor="#2E7D32" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>

                    <TextView android:text="离开阈值" android:textSize="13sp" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>
                    <TextView android:id="@+id/tv_rec_far" android:textSize="13sp" android:textStyle="bold" android:textColor="#2E7D32" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>

                    <TextView android:text="滞回区间" android:textSize="13sp" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>
                    <TextView android:id="@+id/tv_rec_hyster" android:textSize="13sp" android:textStyle="bold" android:textColor="#2E7D32" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>

                    <TextView android:text="扫描间隔" android:textSize="13sp" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>
                    <TextView android:id="@+id/tv_rec_interval" android:textSize="13sp" android:textStyle="bold" android:textColor="#2E7D32" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>

                    <TextView android:text="连续达标" android:textSize="13sp" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>
                    <TextView android:id="@+id/tv_rec_consec" android:textSize="13sp" android:textStyle="bold" android:textColor="#2E7D32" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>

                    <TextView android:text="冷却时间" android:textSize="13sp" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>
                    <TextView android:id="@+id/tv_rec_cooldown" android:textSize="13sp" android:textStyle="bold" android:textColor="#2E7D32" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>

                    <TextView android:text="置信度" android:textSize="13sp" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>
                    <TextView android:id="@+id/tv_rec_confidence" android:textSize="13sp" android:textStyle="bold" android:textColor="#FF9800" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp"/>
                </GridLayout>

                <Button
                    android:id="@+id/btn_apply"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="应用这些参数"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4CAF50" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 错误提示 -->
        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#C62828"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>

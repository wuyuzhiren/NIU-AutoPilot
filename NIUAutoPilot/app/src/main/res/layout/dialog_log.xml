<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/niu_card">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="运行日志"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/niu_text"
        android:layout_marginBottom="8dp"/>
    <EditText
        android:id="@+id/et_log_filter"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:hint="搜索：触发/开机/关机/失败/电量…"
        android:background="@drawable/bg_input"
        android:paddingHorizontal="12dp"
        android:textSize="13sp"
        android:textColor="@color/niu_text"
        android:textColorHint="@color/niu_hint"
        android:inputType="text"
        android:singleLine="true"
        android:layout_marginBottom="8dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/niu_input_bg"
        android:padding="8dp">
        <TextView
            android:id="@+id/tv_log_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="@color/niu_text"/>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <Button
            android:id="@+id/btn_export_log"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="导出日志"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/niu_primary"
            android:layout_marginEnd="6dp"/>
        <Button
            android:id="@+id/btn_close_log"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="关闭"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/niu_text_secondary"/>
    </LinearLayout>
</LinearLayout>

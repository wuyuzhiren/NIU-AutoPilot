<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/niu_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="我的"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/niu_text"
            android:layout_marginBottom="16dp"/>

        <!-- 小牛账号 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="小牛账号"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/niu_text"
            android:layout_marginBottom="10dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <!-- 未登录状态 -->
            <LinearLayout android:id="@+id/ll_login_form" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="手机号" android:textSize="13sp" android:textColor="@color/niu_text_secondary" android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/et_account"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:textColor="@color/niu_text"
                    android:inputType="phone"
                    android:hint="请输入小牛账号手机号"
                    android:textColorHint="@color/niu_hint"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="密码" android:textSize="13sp" android:textColor="@color/niu_text_secondary" android:layout_marginTop="12dp" android:layout_marginBottom="4dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:textColor="@color/niu_text"
                        android:inputType="textPassword"
                        android:hint="小牛App登录密码"
                        android:textColorHint="@color/niu_hint"/>
                    <ImageView
                        android:id="@+id/iv_eye"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_view"
                        android:tint="@color/niu_hint"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cb_remember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="记住密码"
                    android:textSize="13sp"
                    android:textColor="@color/niu_text_secondary"
                    android:layout_marginTop="10dp"/>

                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:text="登录"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/niu_primary"/>
            </LinearLayout>

            <!-- 已登录状态 -->
            <LinearLayout android:id="@+id/ll_logged_in" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:tint="@color/niu_primary"/>
                    <TextView
                        android:id="@+id/tv_logged_account"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="已登录: 192****3070"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/niu_text"
                        android:layout_marginStart="10dp"/>
                    <TextView
                        android:id="@+id/btn_logout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="退出登录"
                        android:textSize="13sp"
                        android:textColor="@color/niu_error"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 车辆信息 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="车辆信息"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/niu_text"
            android:layout_marginBottom="10dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="车辆 SN" android:textSize="13sp" android:textColor="@color/niu_text_secondary" android:layout_marginBottom="4dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/et_sn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/niu_text"
                    android:hint="粘贴你的车辆SN"
                    android:textColorHint="@color/niu_hint"
                    android:inputType="text"/>
                <ImageView
                    android:id="@+id/iv_sn_check"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="4dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:tint="@color/niu_success"
                    android:visibility="gone"/>
                <ImageView
                    android:id="@+id/iv_edit_sn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:tint="@color/niu_hint"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="官方 App 里「关于」可查"
                android:textSize="12sp"
                android:textColor="@color/niu_hint"
                android:layout_marginTop="6dp"/>

            <Button
                android:id="@+id/btn_save_sn"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="保存绑定"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/niu_primary"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="小牛靠近开机助手 v2.8"
            android:textSize="11sp"
            android:textColor="@color/niu_hint"
            android:gravity="center"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
</ScrollView>


<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="10dp">

    <!-- 状态条 -->
    <TextView
        android:id="@+id/tv_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="小牛助手"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:singleLine="true"
        android:ellipsize="end"/>

    <!-- 第一行：开机 关机 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <TextView
            android:id="@+id/btn_widget_on"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="开机"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/bg_widget_btn_on"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/btn_widget_off"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="关机"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/bg_widget_btn_off"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- 第二行：坐桶 自动 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_widget_seat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="开坐桶"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/bg_widget_btn_seat"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/btn_widget_auto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="自动开机"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/bg_widget_btn_auto"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</LinearLayout>

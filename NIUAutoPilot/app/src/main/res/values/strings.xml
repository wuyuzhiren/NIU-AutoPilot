<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">小牛靠近开机助手</string>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1a237e</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#616161</item>
        <item name="android:paddingTop">6dp</item>
    </style>

    <style name="LabelHalf">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#616161</item>
        <item name="android:paddingTop">10dp</item>
    </style>

    <style name="EditField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:inputType">text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@android:drawable/editbox_background</item>
        <item name="android:padding">4dp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="EditFieldHalf">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:inputType">number</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@android:drawable/editbox_background</item>
        <item name="android:padding">4dp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
</resources>
